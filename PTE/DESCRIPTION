Package: PTE
Type: Package
Title: Personalized Treatment Evaluator
Version: 2.0
Date: 2027-07-26
Authors@R: c(
    person("Adam", "Kapelner", email = "kapelner@qc.cuny.edu", role = c("aut", "cre")),
